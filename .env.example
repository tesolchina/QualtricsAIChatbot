# OpenRouter API Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Qualtrics API Configuration
QUALTRICS_API_KEY=your_qualtrics_api_key_here
QUALTRICS_DATA_CENTER=your_datacenter_here

# Optional: Specify which model to use with OpenRouter
# Examples: openai/gpt-4, anthropic/claude-3-opus, meta-llama/llama-3-70b-instruct
OPENROUTER_MODEL=openai/gpt-4-turbo

# Optional: Your site URL and app name for OpenRouter
OPENROUTER_SITE_URL=https://your-site.com
OPENROUTER_APP_NAME=QualtricsAIChatbot
